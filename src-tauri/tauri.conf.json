{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "veranda",
  "version": "0.1.0",
  "identifier": "com.veranda.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Veranda",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "cli": {
      "description": "Veranda - A lightweight productivity app",
      "subcommands": {
        "timer": {
          "description": "Manage timers",
          "args": [
            {
              "name": "action",
              "index": 1,
              "takesValue": true,
              "possibleValues": ["list", "start", "pause", "reset", "create"],
              "description": "Action: list, start, pause, reset, or create"
            },
            {
              "name": "id",
              "short": "i",
              "takesValue": true,
              "description": "Timer ID for start/pause/reset actions"
            },
            {
              "name": "label",
              "short": "l",
              "takesValue": true,
              "description": "Timer label for create action"
            },
            {
              "name": "duration",
              "short": "d",
              "takesValue": true,
              "description": "Duration in seconds for create action"
            }
          ]
        },
        "stopwatch": {
          "description": "Manage stopwatches",
          "args": [
            {
              "name": "action",
              "index": 1,
              "takesValue": true,
              "possibleValues": ["list", "start", "pause", "reset", "create"],
              "description": "Action: list, start, pause, reset, or create"
            },
            {
              "name": "id",
              "short": "i",
              "takesValue": true,
              "description": "Stopwatch ID for start/pause/reset actions"
            },
            {
              "name": "label",
              "short": "l",
              "takesValue": true,
              "description": "Stopwatch label for create action"
            }
          ]
        },
        "todo": {
          "description": "Manage todos",
          "args": [
            {
              "name": "action",
              "index": 1,
              "takesValue": true,
              "possibleValues": ["list", "add", "done", "archive"],
              "description": "Action: list, add, done, or archive"
            },
            {
              "name": "task",
              "short": "t",
              "takesValue": true,
              "description": "Task name for add action"
            },
            {
              "name": "id",
              "short": "i",
              "takesValue": true,
              "description": "Todo ID for done/archive actions"
            }
          ]
        },
        "daemon": {
          "description": "Run background daemon only (no GUI)"
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon-32x32.png",
      "icons/icon-128x128.png",
      "icons/icon-256x256.png",
      "icons/icon-512x512.png",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": null,
      "entitlements": null,
      "minimumSystemVersion": "10.13"
    },
    "category": "Productivity"
  }
}
